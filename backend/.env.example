OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_MODEL_FAST=gpt-4o-mini

# Critic: average score below avg OR any channel below min triggers refinement (then optional recheck loop)
# CRITIC_SCORE_THRESHOLD_AVG=75
# CRITIC_SCORE_THRESHOLD_MIN=60
# CRITIC_MAX_REFINE_ROUNDS=2
OPENAI_WEB_SEARCH_TOOL=web_search_preview
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_MAX_IMAGES=4
# Cap total post images in one run; variants per post (DALL·E 3 size is chosen per platform).
# MAX_SCHEDULE_POST_IMAGES=48
# MAX_IMAGE_VARIANTS_PER_POST=3
# MEDIA_ROOT=./data/media

# Default: Pix API returns raw image/webp from GET ?text=
IMAGE_PROVIDER=http
IMAGE_HTTP_TEMPLATE=https://pix.praanav.in/generate-image?text={prompt}

# Use OpenAI DALL·E instead:
# IMAGE_PROVIDER=openai

CORS_ORIGINS=http://localhost:5173
# Base URL embedded in QR codes (your deployed frontend origin).
PUBLIC_APP_URL=http://localhost:5173

# Firebase (optional — persistence via Firestore)
# Place your service account key at backend/firebase-sa.json
# or set GOOGLE_APPLICATION_CREDENTIALS=./firebase-sa.json

# Instagram — instagrapi (use a secondary/burner account)
INSTAGRAPI_USERNAME=
INSTAGRAPI_PASSWORD=
# Optional: browser cookie `sessionid` for instagram.com (DevTools → Application → Cookies).
# Use when password login returns BadPassword / Facebook-linked / IP blacklist (see instagrapi#1498).

INSTAGRAPI_SESSION_FILE=backend/instagrapi_session.json

# Instagram Graph API (Meta) — used by backend/test.py (official API, webhook / Graph token)
# Generate a long-lived User access token in Meta Developer with instagram_basic, pages_show_list,
# and permissions for the connected IG Business account.
# One long line — no line breaks inside the token (OAuth 190 "Cannot parse" if broken)
IG_ACCESS_TOKEN=
# Optional: read token from a file instead (one line). Overrides IG_ACCESS_TOKEN if set.
# IG_ACCESS_TOKEN_FILE=backend/ig_token.txt
# Instagram Business Account ID (Graph), e.g. 17841465868035234 for @orbvent.official

# Optional: override Graph version (default v21.0)
# IG_GRAPH_API_VERSION=v21.0
# Debug: print JSON from GET me/accounts (find instagram_business_account.id)
# set IG_DISCOVER_ONLY=1 && python test.py
# Optional: comma-separated HTTP(S) proxy URLs (use your provider's real hostname, not the word "host")
# INSTAGRAPI_PROXIES=http://user:pass@gw.your-provider.com:8080
